#!/usr/bin/env bash

# Neovim Local IDE Wrapper Script
# Runs Neovim locally without Docker
# Usage: ./bin/neovim-local [file or directory]

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# ============================================
# Helper Functions
# ============================================

log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check if Neovim is installed
check_neovim() {
    if ! command -v nvim &> /dev/null; then
        log_error "Neovim is not installed or not in PATH"
        log_info "Install with: brew install neovim"
        exit 1
    fi
}

# Determine workspace path
get_workspace_path() {
    local target_path="${1:-.}"

    # Resolve to absolute path
    if [ -d "$target_path" ]; then
        # It's a directory
        echo "$(cd "$target_path" && pwd)"
    elif [ -f "$target_path" ]; then
        # It's a file - get the directory
        echo "$(cd "$(dirname "$target_path")" && pwd)"
    else
        # Doesn't exist - use current directory
        log_warning "Path '$target_path' not found. Using current directory."
        echo "$(pwd)"
    fi
}

# Determine file to open in Neovim (relative to workspace)
get_target_file() {
    local target_path="${1:-.}"

    if [ -f "$target_path" ]; then
        # Return just the filename
        basename "$target_path"
    else
        # No specific file, Neovim will open directory view
        echo "."
    fi
}

# ============================================
# Main Script
# ============================================

main() {
    log_info "Starting Neovim (Local)..."

    # Check Neovim availability
    check_neovim

    # Determine workspace and target
    WORKSPACE_PATH=$(get_workspace_path "$1")
    TARGET_FILE=$(get_target_file "$1")

    log_info "Workspace: $WORKSPACE_PATH"
    log_info "Using local Neovim configuration from: $PROJECT_ROOT/nvim"

    # Set environment variables for local Neovim
    export NVIM_APPNAME="nvim"  # Use the nvim config directory
    export XDG_CONFIG_HOME="$PROJECT_ROOT"
    export EDITOR="nvim"

    log_info "Launching Neovim..."

    # Change to workspace directory and run Neovim
    cd "$WORKSPACE_PATH"

    # Run Neovim with the configuration from the project
    nvim -u "$PROJECT_ROOT/nvim/init.lua" "$TARGET_FILE" "${@:2}"

    exit_code=$?

    if [ $exit_code -eq 0 ]; then
        log_success "Neovim session ended"
    else
        log_error "Neovim exited with code $exit_code"
    fi

    return $exit_code
}

# ============================================
# Entry Point
# ============================================

# Handle special flags
case "${1:-}" in
    --help|-h)
        echo "Neovim Local IDE Wrapper"
        echo ""
        echo "Runs Neovim locally without Docker."
        echo "Uses the Neovim configuration from ./nvim directory."
        echo ""
        echo "Usage:"
        echo "  $0 [file or directory] [neovim options]"
        echo ""
        echo "Examples:"
        echo "  $0                    # Open current directory"
        echo "  $0 .                  # Open current directory"
        echo "  $0 /path/to/project   # Open specific directory"
        echo "  $0 file.txt           # Open specific file"
        echo "  $0 --version          # Show local Neovim version"
        echo ""
        echo "Options:"
        echo "  -h, --help            Show this help message"
        echo "  --version             Show local Neovim version"
        echo ""
        echo "Benefits:"
        echo "  ✓ No Docker overhead"
        echo "  ✓ Native clipboard access (works perfectly with macOS)"
        echo "  ✓ Faster startup"
        echo "  ✓ Direct file access without volume mounts"
        echo ""
        echo "Requirements:"
        echo "  • Neovim installed (brew install neovim)"
        echo "  • Same LSP servers as Docker version"
        echo ""
        exit 0
        ;;
    --version)
        check_neovim
        log_info "Local Neovim version:"
        nvim --version
        exit 0
        ;;
    --check)
        log_info "Checking local Neovim setup..."
        check_neovim

        NVIM_VERSION=$(nvim --version | head -1)
        log_success "Neovim installed: $NVIM_VERSION"

        if [ -d "$PROJECT_ROOT/nvim" ]; then
            log_success "Configuration directory found: $PROJECT_ROOT/nvim"
        else
            log_error "Configuration directory NOT found: $PROJECT_ROOT/nvim"
            exit 1
        fi

        if [ -f "$PROJECT_ROOT/nvim/init.lua" ]; then
            log_success "init.lua found"
        else
            log_error "init.lua NOT found"
            exit 1
        fi

        # Check for LSP servers
        log_info "Checking LSP servers..."

        if command -v node &> /dev/null; then
            log_success "Node.js installed (for TypeScript/Vue LSP)"
        else
            log_warning "Node.js not installed (needed for TypeScript/Vue LSP)"
        fi

        if command -v php &> /dev/null; then
            log_success "PHP installed (for PHP LSP)"
        else
            log_warning "PHP not installed (needed for PHP LSP)"
        fi

        exit 0
        ;;
esac

# Run main function
main "$@"
